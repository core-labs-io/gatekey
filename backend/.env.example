# Gatekey backend - environment configuration template.
# Copy to `.env` for local development. NEVER commit a populated .env file
# (see repo .gitignore - .env is already excluded).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://gatekey:gatekey@localhost:5432/gatekey

# --- Admin auth ---
# Break-glass/bootstrap bearer token with full Org Admin rights - a
# permanent secondary auth path alongside optional SSO.
# Generate a long random value, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
GATEKEY_ADMIN_TOKEN=changeme-generate-a-long-random-token

# --- Encryption ---
# 32-byte AES-256 key, base64-encoded (44 chars incl. padding).
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS KEY UP - losing it makes every secret stored in the database
# permanently unrecoverable. Pluggable KMS backends (Vault/AWS KMS/GCP KMS)
# are a later concern - see services/encryption.py's KeyProvider seam.
GATEKEY_MASTER_KEY=

# --- Provider key validation ---
# Single-attempt timeout applied to the outbound validation call made to the
# provider when a key is submitted via PUT /v1/admin/providers/{provider}/key.
GATEKEY_PROVIDER_VALIDATION_TIMEOUT_SECONDS=8

# --- Frontend origin (CORS) ---
# The browser frontend's origin. Session cookies (SSO) require credentialed
# CORS, which forbids wildcards - this exact origin (plus any extra origins
# in GATEKEY_CORS_ALLOWED_ORIGINS; "*" entries are ignored) is what the
# backend allows.
GATEKEY_FRONTEND_ORIGIN=http://localhost:3000

# --- Optional: SSO (OIDC authorization-code flow) ---
# Fully optional - leave unset and SSO routes return 404 (break-glass admin
# token stays the only auth path). If ANY of the four GATEKEY_OIDC_* vars is
# set, ALL FOUR are required (startup fails fast otherwise). Values below
# match the dev Keycloak realm started via `docker-compose --profile sso`.
# GATEKEY_OIDC_ISSUER_URL=http://localhost:8080/realms/gatekey-dev
# GATEKEY_OIDC_CLIENT_ID=gatekey-backend
# GATEKEY_OIDC_CLIENT_SECRET=<matches devops/keycloak/gatekey-realm.json>
# GATEKEY_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/sso/callback

# --- Optional: session cookie ---
# Secure flag on the session cookie - set false ONLY for local http dev.
# GATEKEY_SESSION_COOKIE_SECURE=true
# GATEKEY_SESSION_TTL_HOURS=12

# --- Optional: SMTP threshold-alert email ---
# Leave unset and the email notifier is a no-op. If any GATEKEY_SMTP_* var is
# set, HOST and FROM_ADDRESS are required (startup fails fast otherwise).
# GATEKEY_SMTP_HOST=smtp.example.com
# GATEKEY_SMTP_PORT=587
# GATEKEY_SMTP_USERNAME=
# GATEKEY_SMTP_PASSWORD=
# GATEKEY_SMTP_FROM_ADDRESS=gatekey-alerts@example.com
# GATEKEY_SMTP_USE_TLS=true

# --- Optional: trust proxy headers for audit source-IP capture ---
# Off by default. A client-supplied X-Forwarded-For/X-Real-IP header is
# fully spoofable unless something in front of the backend overwrites/strips
# it - only set this to true if you are running behind a reverse proxy that
# does that. See api/deps.py's get_source_ip for the exact trust logic.
# GATEKEY_TRUST_PROXY_HEADERS=false

# --- Optional: Redis (rate limiting, response caching, shared state) ---
# Unset = these features disabled (failover works without Redis). For a
# local Redis on the default port:
# GATEKEY_REDIS_URL=redis://localhost:6379/0
