# Gatekey - PRODUCTION docker-compose environment configuration.
#
# Copy to `.env` next to docker-compose.prod.yml and fill in the four
# required values, then:
#
#   docker compose -f docker-compose.prod.yml up -d
#
# Full production guide (TLS, backups, upgrades, SSO): docs/production.md
# NEVER commit a populated .env file.

# ============================================================================
# REQUIRED
# ============================================================================

# The public domain Gatekey is served on. DNS for this name must point at
# this host, and ports 80+443 must be reachable from the internet - Caddy
# then provisions and renews a Let's Encrypt certificate automatically.
# (For a local TLS smoke test only: GATEKEY_DOMAIN=localhost gives a
# self-signed certificate.)
GATEKEY_DOMAIN=gatekey.example.com

# Postgres password for the bundled database container (username/database
# are both `gatekey`). Use letters and digits only - the value is embedded
# in a connection URL, so URL-special characters (@ : / ? # %) would need
# percent-encoding. Generate: openssl rand -hex 24
GATEKEY_DB_PASSWORD=

# Admin bearer token for the admin console / admin API - the break-glass
# credential with full Org Admin rights; treat it like a root password.
# Generate: openssl rand -hex 32
GATEKEY_ADMIN_TOKEN=

# Base64-encoded 32-byte AES-256 key encrypting provider keys and other
# secrets at rest. Generate: openssl rand -base64 32
#
# *** BACK THIS KEY UP (password manager / secrets vault). Losing it makes ***
# *** every secret stored in the database permanently unrecoverable.      ***
GATEKEY_MASTER_KEY=

# ============================================================================
# IMAGES (optional overrides)
# ============================================================================
# By default the prod compose file builds from the local checkout when you
# pass --build, and otherwise pulls these images. Pin a released version
# instead of a moving tag for real deployments, e.g. :0.1.0
# GATEKEY_BACKEND_IMAGE=ghcr.io/core-labs-io/gatekey-backend:0.1.0
# GATEKEY_FRONTEND_IMAGE=ghcr.io/core-labs-io/gatekey-frontend:0.1.0

# ============================================================================
# OPTIONAL - Redis (rate limiting, response caching, shared state)
# ============================================================================
# Start with: docker compose -f docker-compose.prod.yml --profile cache up -d
# AND uncomment (both steps required):
# GATEKEY_REDIS_URL=redis://redis:6379/0

# ============================================================================
# OPTIONAL - SSO (see docs/production.md for per-IdP walkthroughs)
# ============================================================================
# All four all-or-none. The redirect URI for this deployment is:
#   https://<GATEKEY_DOMAIN>/v1/auth/sso/callback
# GATEKEY_OIDC_ISSUER_URL=
# GATEKEY_OIDC_CLIENT_ID=
# GATEKEY_OIDC_CLIENT_SECRET=
# GATEKEY_OIDC_REDIRECT_URI=https://gatekey.example.com/v1/auth/sso/callback
# GATEKEY_SESSION_TTL_HOURS=12
# NOTE: do NOT set GATEKEY_SESSION_COOKIE_SECURE=false here - production is
# TLS-terminated by Caddy, so the secure-cookie default is correct.

# ============================================================================
# OPTIONAL - SMTP threshold-alert email
# ============================================================================
# GATEKEY_SMTP_HOST=
# GATEKEY_SMTP_PORT=587
# GATEKEY_SMTP_USERNAME=
# GATEKEY_SMTP_PASSWORD=
# GATEKEY_SMTP_FROM_ADDRESS=
# GATEKEY_SMTP_USE_TLS=true
