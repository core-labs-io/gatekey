# Gatekey - docker-compose environment configuration.
# Copy to `.env` (same directory as docker-compose.yml) before running
# `docker-compose up`. NEVER commit a populated .env file.

# Shared admin bearer token for the admin console / admin API (Phase 1 has
# no user accounts, just this one shared secret - see backend/.env.example
# for the full rationale). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEKEY_ADMIN_TOKEN=changeme-generate-a-long-random-token

# Base64-encoded 32-byte AES-256 key used to encrypt provider keys at rest.
# Generate one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
GATEKEY_MASTER_KEY=

# Optional: override the browser-facing backend URL the frontend is built
# against (defaults to http://localhost:8000, correct for a local
# `docker-compose up` on the same machine you're browsing from).
# GATEKEY_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: outbound provider-key-validation timeout (seconds).
# GATEKEY_PROVIDER_VALIDATION_TIMEOUT_SECONDS=8

# Optional: SSO (Phase 2, `docker compose --profile sso up` starts a bundled
# dev-only Keycloak at http://localhost:8080, admin/admin, with a seeded
# realm "gatekey-dev", client "gatekey-backend" and a test user
# testuser/testpassword - see devops/keycloak/gatekey-realm.json).
# All four GATEKEY_OIDC_* variables are all-or-none: set all of them or
# none (unset = SSO disabled, admin-token auth only).
#
# Issuer URL - which value depends on WHERE the backend runs:
#   - Backend inside docker-compose (the default): use the internal service
#     name. Keycloak's KC_HOSTNAME/KC_HOSTNAME_BACKCHANNEL_DYNAMIC config in
#     docker-compose.yml keeps browser redirects and the token issuer on
#     http://localhost:8080 while the backend reaches Keycloak at
#     http://keycloak:8080.
# GATEKEY_OIDC_ISSUER_URL=http://keycloak:8080/realms/gatekey-dev
#   - Backend running locally OUTSIDE compose (dev against `--profile sso`
#     Keycloak only): use the host-published port instead.
# GATEKEY_OIDC_ISSUER_URL=http://localhost:8080/realms/gatekey-dev
#
# GATEKEY_OIDC_CLIENT_ID=gatekey-backend
# Dev-only secret, fixed in devops/keycloak/gatekey-realm.json - replace
# both together if you change it. Use a real secret with a real IdP.
# GATEKEY_OIDC_CLIENT_SECRET=gatekey-dev-client-secret
# GATEKEY_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/sso/callback
#
# Session cookies are `Secure` by default; local docker-compose dev serves
# plain http, so the cookie would never be sent - set false ONLY for local
# http dev, never in production.
# GATEKEY_SESSION_COOKIE_SECURE=false

# Optional: trust X-Forwarded-For/X-Real-IP for audit source-IP capture
# (Phase 3). Off by default - only set true if the backend runs behind a
# reverse proxy that overwrites/strips these headers on the way in; a
# self-hosted instance exposed directly to the internet must leave this
# unset (see backend/.env.example and backend/src/gatekey/api/deps.py's
# get_source_ip for the spoofing rationale).
# GATEKEY_TRUST_PROXY_HEADERS=false
