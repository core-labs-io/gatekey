# Gatekey — docker-compose environment configuration.
#
# Copy to `.env` (same directory as docker-compose.yml) before running
# `docker compose up`, or just run ./setup.sh (or .\setup.ps1 on Windows),
# which generates the two required secrets and writes this file for you.
# NEVER commit a populated .env file.
#
# Full reference for every variable: docs/configuration.md

# ============================================================================
# REQUIRED (the only two values you must set)
# ============================================================================

# Admin bearer token for the admin console / admin API. This is the
# break-glass credential with full Org Admin rights — treat it like a root
# password. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (or let setup.sh / setup.ps1 generate it for you — no Python needed)
GATEKEY_ADMIN_TOKEN=changeme-generate-a-long-random-token

# Base64-encoded 32-byte AES-256 key used to encrypt provider keys and other
# secrets at rest. Generate one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# *** BACK THIS KEY UP SOMEWHERE SAFE (password manager / secrets vault). ***
# *** If you lose it, every provider key and webhook URL stored in the     ***
# *** database becomes permanently unrecoverable — there is no reset path; ***
# *** you would have to re-enter every secret by hand.                     ***
GATEKEY_MASTER_KEY=

# ============================================================================
# OPTIONAL — Redis-backed features (rate limiting, response caching,
# shared state for multi-replica deployments)
# ============================================================================

# BOTH of these are needed to enable Redis features:
#   1. Start the bundled Redis:   docker compose --profile cache up
#   2. Uncomment the URL below (this exact value is correct in-compose —
#      `redis` is the compose service name):
# GATEKEY_REDIS_URL=redis://redis:6379/0
#
# Starting `--profile cache` WITHOUT setting GATEKEY_REDIS_URL runs a Redis
# container the backend never talks to — the URL is what turns the
# features on. Unset = rate limiting/caching/shared state disabled
# (everything else, including failover, works without Redis).

# ============================================================================
# OPTIONAL — networking / CORS
# ============================================================================

# Browser-facing backend URL the frontend is built against. Default is
# correct for a local `docker compose up` browsed from the same machine.
# GATEKEY_PUBLIC_API_BASE_URL=http://localhost:8000

# The console's browser origin (always CORS-allowed, and the origin session
# cookies are exchanged with). Set this if the console is NOT browsed at
# http://localhost:3000.
# GATEKEY_FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated ADDITIONAL browser origins allowed to call the API.
# Wildcard `*` entries are ignored (incompatible with cookie auth).
# GATEKEY_CORS_ALLOWED_ORIGINS=

# Trust X-Forwarded-For/X-Real-IP for audit source-IP capture. Only set true
# if the backend runs behind a reverse proxy that overwrites/strips these
# headers on the way in — otherwise the header is client-spoofable. An
# instance exposed directly to the internet must leave this unset.
# GATEKEY_TRUST_PROXY_HEADERS=false

# Timeout (seconds) for the live validation call made when a provider key
# is entered.
# GATEKEY_PROVIDER_VALIDATION_TIMEOUT_SECONDS=8

# ============================================================================
# OPTIONAL — SSO (OIDC single sign-on)
# ============================================================================
# Full walkthrough (bundled dev Keycloak + production IdPs): docs/sso.md
#
# All four GATEKEY_OIDC_* variables are all-or-none: set all of them or none
# (unset = SSO disabled, admin-token auth only; startup fails fast on a
# partial set).
#
# The values below match the bundled DEV-ONLY Keycloak started by
# `docker compose --profile sso up` (admin console http://localhost:8080,
# admin/admin, seeded test user testuser/testpassword — never expose it
# publicly). Note the issuer host is `keycloak:8080` (the in-compose service
# name) when the backend runs inside compose; use
# http://localhost:8080/realms/gatekey-dev only for a backend running
# OUTSIDE compose.
# GATEKEY_OIDC_ISSUER_URL=http://keycloak:8080/realms/gatekey-dev
# GATEKEY_OIDC_CLIENT_ID=gatekey-backend
# GATEKEY_OIDC_CLIENT_SECRET=gatekey-dev-client-secret
# GATEKEY_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/sso/callback

# Session cookies are `Secure` by default; local docker-compose dev serves
# plain http, so the cookie would never be sent — set false ONLY for local
# http dev, never in production.
# GATEKEY_SESSION_COOKIE_SECURE=false

# Session lifetime in hours (default 12).
# GATEKEY_SESSION_TTL_HOURS=12

# ============================================================================
# OPTIONAL — SMTP for budget threshold-alert email
# ============================================================================
# Leave all unset and the email notifier is a silent no-op (webhook alerts
# need no server config). If ANY GATEKEY_SMTP_* var is set, HOST and
# FROM_ADDRESS become required (startup fails fast otherwise).
# GATEKEY_SMTP_HOST=
# GATEKEY_SMTP_PORT=587
# GATEKEY_SMTP_USERNAME=
# GATEKEY_SMTP_PASSWORD=
# GATEKEY_SMTP_FROM_ADDRESS=
# GATEKEY_SMTP_USE_TLS=true
